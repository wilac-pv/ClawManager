[Unit]
Description=Clean expired Ruying Skill Market private objects
After=network-online.target ruying-skill-market.service

[Service]
Type=oneshot
User=ruying-market
Group=ruying-market
EnvironmentFile=/etc/ruying-skill-market/market.env
WorkingDirectory=/srv/ruying-skill-market/current/packages/skill-market-server
ExecStart=/usr/bin/flock -n -E 0 /run/lock/ruying-skill-market-ops.lock /usr/local/bin/bun script/cleanup.ts
Restart=on-failure
RestartSec=5min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ruying-skill-market /var/backups/ruying-skill-market
ReadWritePaths=/run/lock
UMask=0077
LimitNOFILE=65536
TasksMax=256
MemoryHigh=384M
MemoryMax=512M
TimeoutStartSec=5min
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
