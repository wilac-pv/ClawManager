[Unit]
Description=Mirror SkillHub into Ruying Skill Market
After=network-online.target ruying-skill-market.service

[Service]
Type=oneshot
User=ruying-market
Group=ruying-market
EnvironmentFile=/etc/ruying-skill-market/market.env
WorkingDirectory=/srv/ruying-skill-market/current/packages/skill-market-server
ExecStart=/usr/bin/flock -w 30 /run/lock/ruying-skill-market-ops.lock /usr/local/bin/bun --smol src/skillhub-worker.js
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ruying-skill-market /var/backups/ruying-skill-market
ReadWritePaths=/run/lock
UMask=0077
LimitNOFILE=65536
TasksMax=256
MemoryHigh=1536M
MemoryMax=2048M
TimeoutStartSec=2min
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
