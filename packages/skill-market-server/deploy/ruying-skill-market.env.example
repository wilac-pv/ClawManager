# Install as /etc/ruying-skill-market/market.env with root:ruying-market 0640.
SKILL_MARKET_PORT=4210
SKILL_MARKET_DATABASE_PATH=/var/lib/ruying-skill-market/market.db
SKILL_MARKET_MIGRATION_BACKUP_DIRECTORY=/var/backups/ruying-skill-market/migrations
SKILL_MARKET_OPERATION_BACKUP_DIRECTORY=/var/backups/ruying-skill-market/operations
SKILL_MARKET_RESTORE_DIRECTORY=/var/lib/ruying-skill-market/restore-drill
SKILL_MARKET_ENTERPRISE_INDEX_URL=https://replace.example/index.json
SKILL_MARKET_OSS_ENDPOINT=https://replace.example
SKILL_MARKET_ALLOW_INSECURE_OSS_HTTP=false
SKILL_MARKET_OSS_REGION=cn-baoding
SKILL_MARKET_OSS_BUCKET=replace-me
SKILL_MARKET_OSS_PREFIX=ai-coding/ruying-code/skill-market-test
SKILL_MARKET_PRIVATE_OSS_PREFIX=ai-coding/ruying-code/skill-market-private-test
SKILL_MARKET_PUBLIC_BASE_URL=https://replace.example/ai-coding/ruying-code/skill-market-test/
SKILL_MARKET_ALLOW_INSECURE_PUBLIC_HTTP=false
SKILL_MARKET_WEB_ORIGIN=https://replace.example
SKILL_MARKET_WEB_BASE_PATH=/
SKILL_MARKET_API_PUBLIC_URL=https://replace.example
SKILL_MARKET_ALLOW_INSECURE_IP_HTTP=false
SKILL_MARKET_SSO_LOGIN_URL=https://sso.gwm.cn/login
SKILL_MARKET_ADMIN_API_BASE_URL=https://aicoding-admin.gwm.cn
SKILL_MARKET_BOOTSTRAP_ADMIN_EMPLOYEE_IDS=
SKILL_MARKET_ALLOWED_HOSTS=api.skillhub.cn
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
