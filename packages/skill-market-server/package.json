{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/skill-market-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "backup": "bun script/backup.ts",
    "build:release": "bun script/build-release.ts",
    "cleanup": "bun script/cleanup.ts",
    "deploy-check": "bun script/deploy-check.ts",
    "migrate": "bun script/migrate.ts",
    "restore-drill": "bun script/restore-drill.ts",
    "start": "bun src/server.ts",
    "sync": "bun src/sync.ts",
    "skillhub-worker": "bun src/skillhub-worker.ts",
    "evaluation-worker": "bun src/skillhub-evaluation-worker.ts",
    "worker": "bun src/worker.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "@effect/platform-node": "catalog:",
    "@opencode-ai/protocol": "workspace:*",
    "@opencode-ai/schema": "workspace:*",
    "effect": "catalog:",
    "esprima": "4.0.1",
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
