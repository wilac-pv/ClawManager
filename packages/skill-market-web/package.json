{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/skill-market-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "release": "bun script/release.ts",
    "test": "bun run test:unit && bun run test:browser",
    "test:unit": "bun test src/*.test.ts script/*.test.ts",
    "test:browser": "bun test --conditions=browser --preload ./happydom.ts --preload ./solid-test-preload.ts src/*.test.tsx src/submissions/*.test.tsx",
    "typecheck": "tsgo --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "@opencode-ai/app": "workspace:*",
    "@opencode-ai/schema": "workspace:*",
    "@solidjs/router": "catalog:",
    "@tanstack/solid-query": "5.91.4",
    "effect": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@playwright/test": "catalog:",
    "@solidjs/testing-library": "0.8.10",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
